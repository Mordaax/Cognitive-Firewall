FIREWALL_AGENT_TOKEN=replace-with-random-agent-token
FIREWALL_OPERATOR_TOKEN=replace-with-different-random-operator-token
FIREWALL_MAPPING_KEY=base64-encoded-32-byte-key
FIREWALL_HMAC_KEY=base64-encoded-32-byte-key
FIREWALL_DATABASE_URL=sqlite:///./firewall.sqlite3
FIREWALL_POLICY_PATH=policies/default.yaml
# Optional report cache. Admission decisions never use Redis.
FIREWALL_REDIS_URL=
# Set only when enabling the postgres Compose profile.
FIREWALL_POSTGRES_PASSWORD=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# The single agent token above is bound to this one identity.
FIREWALL_AGENT_ID=demo-agent
# Additional distinct agent tokens, JSON object keyed by agent ID; keep private.
FIREWALL_AGENT_TOKENS={}
FIREWALL_TOOLS_PATH=policies/tools.yaml
# Optional: existing absolute local safetensors model directory; never downloads at runtime.
FIREWALL_SEMANTIC_MODEL_PATH=
FIREWALL_SEMANTIC_LABELS=INJECTION
FIREWALL_SEMANTIC_THRESHOLD=0.8
